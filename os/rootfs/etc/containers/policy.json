{
  "default": [
    {
      "type": "insecureAcceptAnything"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/reclaimexperience/project-meridian": [
        {
          "type": "sigstoreSigned",
          "keyPaths": [
            "/etc/pki/containers/meridian.pub"
          ],
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ]
    }
  }
}
