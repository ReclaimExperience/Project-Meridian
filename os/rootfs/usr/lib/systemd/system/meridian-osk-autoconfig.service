[Unit]
Description=Enable the on-screen keyboard only where there is a touchscreen (ADR-017)
Documentation=file:///usr/share/doc/meridian/adr/ADR-017
# Before the display manager: kwin reads InputMethod when the session starts, so
# deciding after that would take effect one login late — which on a tablet means
# the first boot has no keyboard.
Before=display-manager.service plasmalogin.service
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/meridian/osk-autoconfig
# The image must boot even if this fails. A machine that will not start because
# a memory optimisation errored is a far worse outcome than 72 MiB.
SuccessExitStatus=0 1
StandardOutput=journal

[Install]
WantedBy=multi-user.target
