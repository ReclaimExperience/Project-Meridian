# Pinned lint tool versions (PRD 7.1: if it isn't reproduced from a clean
# checkout, it doesn't exist — which is worthless if CI and a laptop run
# different linters).
#
# This bit: CI installed Ubuntu's shellcheck 0.9.0 while the dev machine had
# Homebrew's 0.11.0. `just lint` was green locally and red in CI on the same
# commit, because 0.11.0 no longer reports an SC2015 that 0.9.0 does.
#
# Bump deliberately, in its own commit, having run the suite locally at the new
# version first.
SHELLCHECK_VERSION=0.11.0
RUFF_VERSION=0.16.5
MARKDOWNLINT_VERSION=0.49.1
